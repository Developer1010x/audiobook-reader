<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Matches Release.entitlements in dropping the App Sandbox — see the reasoning
  there. Debug must match: a sandboxed debug build would fail to spawn Piper or
  Tesseract, so every developer run would exercise a configuration no user ever
  gets, and the features would look broken during development only.
-->
<plist version="1.0">
<dict>
	<!-- Dart VM's JIT, used by debug and profile builds. -->
	<key>com.apple.security.cs.allow-jit</key>
	<true/>
	<!-- Outbound HTTP: Ollama on localhost, cover art and dictionary lookups. -->
	<key>com.apple.security.network.client</key>
	<true/>
	<!-- The Flutter tooling attaches to the running app over a local socket. -->
	<key>com.apple.security.network.server</key>
	<true/>
</dict>
</plist>
