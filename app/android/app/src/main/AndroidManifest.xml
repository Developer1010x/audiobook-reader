<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Only the cloud AI providers reach the network; the library, the reader
         and Piper are all local. Flutter injects INTERNET into the debug and
         profile manifests for the hot-reload channel, so omitting it here fails
         nowhere except release builds — the one place it is hardest to notice. -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- audio_service takes a partial wake lock while the foreground service is
         running. Without it the CPU sleeps a few seconds after the screen goes
         off and playback dies mid-sentence, which is the entire use case. -->
    <uses-permission android:name="android.permission.WAKE_LOCK"/>

    <!-- Required to call startForeground() at all, from Android 9 (API 28). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>

    <!-- Android 14 (API 34) split FOREGROUND_SERVICE into per-type permissions.
         Targeting 34+ without this one, startForeground() throws SecurityException
         the instant the user presses play. We target 36 via flutter.targetSdkVersion. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"/>

    <!-- Android 13 (API 33) made notifications a runtime permission. Declaring it
         is necessary but not sufficient: the service still starts when the user
         denies it, but its notification — and with it the media controls in the
         shade and on the lock screen — is never posted. The runtime request
         belongs on the Dart side, before the first AudioService.init(). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>

    <application
        android:label="Audier"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

        <!-- The foreground service that keeps the isolate alive with the screen
             off. foregroundServiceType is what pairs with the permission above;
             on Android 14+ a service that calls the two-argument
             startForeground() — which AudioService does — and declares no type
             here is killed with MissingForegroundServiceTypeException.
             exported="true" because the MediaBrowserService is how Android Auto,
             Wear and Assistant discover us, and API 31+ refuses to install any
             component that has an intent-filter without an explicit value.
             tools:ignore silences a lint that cannot see the class, which lives
             in the audio_service AAR rather than this module. -->
        <service
            android:name="com.ryanheise.audioservice.AudioService"
            android:foregroundServiceType="mediaPlayback"
            android:exported="true"
            tools:ignore="Instantiatable">
            <intent-filter>
                <action android:name="android.media.browse.MediaBrowserService"/>
            </intent-filter>
        </service>

        <!-- Headset play/pause and the pause-on-unplug behaviour arrive as
             ACTION_MEDIA_BUTTON broadcasts. They are delivered to the manifest
             receiver when the app has no foreground component, which is exactly
             when a sleeping listener taps their earbuds. -->
        <receiver
            android:name="com.ryanheise.audioservice.MediaButtonReceiver"
            android:exported="true"
            tools:ignore="Instantiatable">
            <intent-filter>
                <action android:name="android.intent.action.MEDIA_BUTTON"/>
            </intent-filter>
        </receiver>

        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
